{
  "name": "vscode-central-remote-config",
  "icon": "crc_icon.png",
  "displayName": "VSCode CRC: central-remote-config",
  "description": "An extension to set the configuration of the Continue extension from a remote server",
  "publisher": "orange-ospc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "__REPOSITORY_URL__"
  },
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "crc",
      "properties": {
        "crc.remoteEndPoint": {
          "type": "string",
          "default": "",
          "description": "The remote Continue configuration endpoint."
        },
        "crc.configLabel": {
          "type": "string",
          "default": "default.yaml",
          "description": "The remote Continue configuration filename."
        },
        "crc.apiKey": {
          "type": "string",
          "default": "",
          "description": "The API key [Optional]."
        },
        "crc.apiKeyPattern": {
          "type": "string",
          "default": "__CRC_API_KEY__",
          "description": "The API key pattern possibly defined in the remote configuration file."
        },
        "crc.userHomeDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Custom user home directory path. Leave empty for automatic detection.\n\n**WSL Note**: In WSL environments, automatically uses `/mnt/c/Users/{username}` to access Windows home directory."
        }
      }
    },
    "commands": [
      {
        "command": "central-remote-config.load",
        "title": "CRC: load extension"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "mocha"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.11",
    "@types/vscode": "1.109.0",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "chai": "6.2.2",
    "esbuild": "0.27.3",
    "eslint": "9.39.2",
    "mocha": "11.7.5",
    "npm-run-all": "4.1.5",
    "typescript": "5.9.3"
  }
}
